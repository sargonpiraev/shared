{
  "name": "@sargonpiraev/commitlint-config",
  "version": "0.0.0",
  "description": "Shared Commitlint config (conventional) for sargonpiraev products and packages",
  "keywords": [
    "commitlint",
    "commitlint-config",
    "conventional-commits"
  ],
  "homepage": "https://github.com/sargonpiraev/shared/tree/main/packages/commitlint-config#readme",
  "bugs": {
    "url": "https://github.com/sargonpiraev/shared/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sargonpiraev/shared.git",
    "directory": "packages/commitlint-config"
  },
  "license": "MIT",
  "author": {
    "name": "Sargon Piraev",
    "email": "sargonpiraev@gmail.com"
  },
  "main": "./index.js",
  "files": [
    "index.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"console.log('noop build'); process.exit(0)\"",
    "check-types": "node -e \"console.log('noop check-types'); process.exit(0)\"",
    "commit": "cz",
    "lint": "node -e \"console.log('noop lint'); process.exit(0)\"",
    "test": "node -e \"const c=require('./index.js'); const p=require('./package.json'); if(!Array.isArray(c.extends)||!c.extends.includes('@commitlint/config-conventional')) process.exit(1); if(p.config.commitizen.path!=='cz-conventional-changelog') process.exit(1)\""
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@commitlint/config-conventional": "^21.2.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0"
  },
  "peerDependencies": {
    "@commitlint/cli": ">=19.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
