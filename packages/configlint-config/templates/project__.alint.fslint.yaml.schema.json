{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sargonpiraev/shared/blob/main/packages/configlint-config/templates/project__.alint.fslint.yaml.schema.json",
  "title": "Clone-root .alint.fslint.yaml extends shared fslint project.yaml",
  "type": "object",
  "required": ["extends"],
  "properties": {
    "extends": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "type": "string",
        "pattern": "fslint-config/project\\.yaml"
      }
    }
  }
}
