{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sargonpiraev/shared/blob/main/packages/configlint-config/templates/project__commitlintrc.yaml.schema.json",
  "title": "Clone-root .commitlintrc.yaml extends shared commitlint",
  "type": "object",
  "required": ["extends"],
  "properties": {
    "extends": {
      "type": "array",
      "minItems": 1,
      "prefixItems": [
        {
          "const": "@sargonpiraev/commitlint-config"
        }
      ]
    }
  }
}
