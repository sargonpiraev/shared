{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sargonpiraev/shared/blob/main/packages/configlint-config/templates/project__lefthook.yml.schema.json",
  "title": "Clone-root lefthook.yml extends @sargonpiraev/lefthook-config",
  "type": "object",
  "required": ["extends"],
  "not": {
    "required": ["remotes"]
  },
  "properties": {
    "extends": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "type": "string",
        "pattern": "lefthook-config/lefthook\\.yml"
      }
    }
  }
}
