{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sargonpiraev/shared/blob/main/packages/configlint-config/templates/project__package.json.schema.json",
  "title": "Clone-root package.json portfolio scripts",
  "type": "object",
  "required": ["scripts"],
  "properties": {
    "scripts": {
      "type": "object",
      "required": [
        "test",
        "test:fslint",
        "test:configlint",
        "test:eslint",
        "test:format",
        "test:build",
        "test:check-types",
        "test:unit",
        "test:spec",
        "test:spec:visual",
        "format",
        "npm:install"
      ],
      "properties": {
        "test": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "test:spec:visual|test:spec:perf"
          }
        },
        "test:fslint": {
          "const": "alint check -c .alint.fslint.yaml"
        },
        "test:configlint": {
          "const": "alint check -c .alint.configlint.yaml"
        },
        "test:eslint": {
          "const": "eslint ."
        },
        "test:format": {
          "const": "prettier --check \"**/*.{mjs,cjs,js,ts,tsx,md,json,yaml,yml}\""
        },
        "test:build": {
          "const": "npm run build"
        },
        "test:check-types": {
          "const": "turbo run check-types"
        },
        "test:unit": {
          "const": "turbo run test:unit"
        },
        "test:spec": {
          "type": "string",
          "minLength": 1
        },
        "test:spec:visual": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "const": "prettier --write \"**/*.{mjs,cjs,js,ts,tsx,md,json,yaml,yml}\""
        },
        "npm:install": {
          "const": "npm install"
        }
      }
    }
  }
}
