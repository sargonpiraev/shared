{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sargonpiraev/shared/blob/main/packages/configlint-config/templates/project__project.json.schema.json",
  "title": "Clone-root project.json portfolio targets",
  "type": "object",
  "required": ["$schema", "metadata", "name"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "const": "./node_modules/@sargonpiraev/configlint-config/build/templates/project__project.json.schema.json"
    },
    "name": {
      "type": "string",
      "description": "Project name"
    },
    "metadata": {
      "type": "object",
      "required": ["portBegins"],
      "additionalProperties": false,
      "properties": {
        "portBegins": {
          "type": "integer",
          "minimum": 50000,
          "maximum": 59900,
          "multipleOf": 100,
          "description": "LocalProxy port space start for this clone (meta=50000; siblings step 100 alphabetically)"
        }
      }
    }
  }
}
