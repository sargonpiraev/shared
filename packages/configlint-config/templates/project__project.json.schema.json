{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sargonpiraev/shared/blob/main/packages/configlint-config/templates/project__project.json.schema.json",
  "title": "Clone-root project.json portfolio targets",
  "type": "object",
  "required": ["targets", "metadata"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["portBegins"],
      "properties": {
        "portBegins": {
          "type": "integer",
          "minimum": 50000,
          "maximum": 59900,
          "multipleOf": 100,
          "description": "LocalProxy port space start for this clone (meta=50000; siblings step 100 alphabetically)"
        }
      }
    },
    "targets": {
      "type": "object",
      "propertyNames": {
        "not": {
          "enum": ["test:lint", "test:alint", "test:conftest"]
        }
      },
      "required": [
        "test",
        "test:unit",
        "test:eslint",
        "test:fslint",
        "test:configlint",
        "test:check-types",
        "test:spec",
        "test:spec:visual",
        "test:format",
        "test:pulumi",
        "build",
        "format"
      ],
      "properties": {
        "test": {
          "type": "object",
          "required": ["command"],
          "properties": { "command": { "const": "npm run test" } }
        },
        "test:unit": {
          "type": "object",
          "required": ["command"],
          "properties": { "command": { "const": "npm run test:unit" } }
        },
        "test:eslint": {
          "type": "object",
          "required": ["command"],
          "properties": { "command": { "const": "npm run test:eslint" } }
        },
        "test:fslint": {
          "type": "object",
          "required": ["command"],
          "properties": { "command": { "const": "npm run test:fslint" } }
        },
        "test:configlint": {
          "type": "object",
          "required": ["command"],
          "properties": { "command": { "const": "npm run test:configlint" } }
        },
        "test:check-types": {
          "type": "object",
          "required": ["command"],
          "properties": { "command": { "const": "npm run test:check-types" } }
        },
        "test:spec": {
          "type": "object",
          "required": ["command"],
          "properties": { "command": { "const": "npm run test:spec" } }
        },
        "test:spec:visual": {
          "type": "object",
          "required": ["command"],
          "properties": { "command": { "const": "npm run test:spec:visual" } }
        },
        "test:format": {
          "type": "object",
          "required": ["command"],
          "properties": { "command": { "const": "npm run test:format" } }
        },
        "test:pulumi": {
          "type": "object",
          "required": ["command"],
          "properties": { "command": { "const": "npm run test:pulumi" } }
        },
        "build": {
          "type": "object",
          "required": ["command"],
          "properties": { "command": { "const": "npm run build" } }
        },
        "format": {
          "type": "object",
          "required": ["command"],
          "properties": { "command": { "const": "npm run format" } }
        }
      }
    }
  }
}
