{
  "name": "@sargonpiraev/eslint-config",
  "version": "1.14.0",
  "description": "Shared ESLint flat-config preset for TypeScript / JavaScript",
  "keywords": [
    "eslint",
    "eslint-config",
    "typescript"
  ],
  "homepage": "https://github.com/sargonpiraev/shared/tree/main/packages/eslint-config#readme",
  "bugs": {
    "url": "https://github.com/sargonpiraev/shared/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sargonpiraev/shared.git",
    "directory": "packages/eslint-config"
  },
  "license": "MIT",
  "author": {
    "name": "Sargon Piraev",
    "email": "sargonpiraev@gmail.com"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    },
    "./project": {
      "types": "./build/project.d.ts",
      "import": "./build/project.js"
    },
    "./project-meta": {
      "types": "./build/project-meta.d.ts",
      "import": "./build/project-meta.js"
    },
    "./playwright-specs": {
      "types": "./build/playwright-specs.d.ts",
      "import": "./build/playwright-specs.js"
    }
  },
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ./src --ext .ts",
    "test": "npm run build && node --test test/playwright-specs.test.mjs"
  },
  "dependencies": {
    "@eslint/js": "^9.26.0",
    "globals": "^16.0.0",
    "typescript-eslint": "^8.31.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.33",
    "eslint": "9.39.5",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
